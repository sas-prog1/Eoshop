APP_NAME="Eoshop"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Riyadh
APP_URL=http://localhost:8000
APP_FRONTEND_URL=http://localhost:8000
APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ar_SA

# Central Domain Configuration for Multi-Tenancy
CENTRAL_DOMAINS=localhost,127.0.0.1,eoshop.local
TENANT_BASE_DOMAIN=eoshop.local
ORDER_CHECKOUT_ENABLED=false
ORDER_RESERVATION_TTL_SECONDS=900

# Database Configuration (Main Platform Core DB)
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=platform_main
DB_USERNAME=eoshop
DB_PASSWORD=replace-with-the-same-value-as-root-postgres-password
DB_SSLMODE=prefer

# Tenant Database Template
TENANT_DB_PREFIX=tenant_

# Google Gemini API Key for AI Store Ideas Generation
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
GEMINI_MODEL=gemini-3.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_TIMEOUT=30

LOG_CHANNEL=stderr
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

CACHE_STORE=database
FILESYSTEM_DISK=public
CATALOG_MEDIA_DISK=local
CATALOG_MEDIA_MAX_BYTES=5242880
CATALOG_MEDIA_MAX_PIXELS=25000000
CATALOG_MEDIA_ORPHAN_HOURS=24
STORE_ASSET_DISK=local
STORE_ASSET_MAX_BYTES=5242880
STORE_ASSET_MAX_PIXELS=25000000
STORE_ASSET_MAX_COUNT=20
STORE_ASSET_MAX_TOTAL_BYTES=52428800
STORE_ASSET_ORPHAN_HOURS=24
QUEUE_CONNECTION=database
SESSION_DRIVER=database
SESSION_CONNECTION=pgsql
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
DB_CACHE_CONNECTION=pgsql
DB_CACHE_LOCK_CONNECTION=pgsql
DB_QUEUE_CONNECTION=pgsql
DB_QUEUE_RETRY_AFTER=180

MAIL_MAILER=log
MAIL_FROM_ADDRESS=no-reply@eoshop.local
MAIL_FROM_NAME="Eoshop"
